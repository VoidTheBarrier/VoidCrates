# Normalize text files to LF in the repository
* text=auto eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts
*.sh text eol=lf

# Kotlin / Java / Gradle
*.kt text
*.kts text
*.java text
*.gradle text
*.properties text
*.json text
*.md text
*.yml text
*.yaml text

# Binary files
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary